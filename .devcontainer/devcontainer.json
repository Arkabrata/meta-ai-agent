{
  "name": "Meta Analyst",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "api/main.py"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; cd frontend && npm install; echo '✅ Dependencies installed'",
  "postAttachCommand": {
    "api": "uvicorn api.main:app --host 0.0.0.0 --port 8810 --reload",
    "web": "cd frontend && npm run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "8810": {
      "label": "API",
      "onAutoForward": "silent"
    },
    "5280": {
      "label": "React Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8810, 5280]
}
