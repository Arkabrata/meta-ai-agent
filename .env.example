# Copy to .env and fill in your values
APP_PASSWORD=your-access-password

# --- AI providers (at least one required for analysis/chat) ---
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GROK_API_KEY=xai-your-key-here
# GEMINI_API_KEY=your-google-ai-key

# Optional model overrides (OpenAI path / CLI)
# META_ANALYSIS_MODEL=gpt-4.1-mini
# META_CHAT_MODEL=gpt-4.1-mini
# META_MODEL_NAME=gpt-5-mini
# META_CURRENCY=₹

# --- Meta Marketing API (optional; can also paste token in the UI) ---
# META_ACCESS_TOKEN=EAAB...
# META_AD_ACCOUNT_ID=1234567890

# CLI paths
# META_INPUT_PATH=data/meta_report.xlsx
# META_OUTPUT_PATH=output/meta_ads_with_recommendations.csv
